# ─── Firebase web app config (production build) ──────────────────
# dev/emulator ไม่ต้องใช้ไฟล์นี้ — ค่า dev อยู่ใน src/firebase/firebaseConfig.json
#
# วิธีใช้:
#   - local production build : copy ไฟล์นี้เป็น .env.production.local แล้วใส่ค่าจริง
#   - CI/CD (GitHub Actions)  : ตั้งค่าใน GitHub Secrets + Variables
#                               (ดู README.md → "ขั้นตอนติดตั้ง" ข้อ 3)
#
# ค่าทั้งหมดหาได้จาก Firebase Console → Project settings → Your apps → Web
# ⚠️ ห้าม commit .env.production.local หรือ .env.local เข้า repo

# Secret (GitHub Secrets)
VITE_FIREBASE_API_KEY=

# Variables (GitHub Variables)
VITE_FIREBASE_AUTH_DOMAIN=petchmangkorn-bot.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=petchmangkorn-bot
VITE_FIREBASE_STORAGE_BUCKET=petchmangkorn-bot.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ชื่อ named Firestore database — ต้องตรงกับ firebase.json · storage.rules ·
# functions/src/helpers/config.ts (default = petchmangkorn-bot)
VITE_FIRESTORE_DATABASE_ID=petchmangkorn-bot

# LINE Login channel ID (ตัวเลข) — ใช้ตอน redirect ไปหน้า login ของ LINE
VITE_LINE_LOGIN_CHANNEL_ID=

# ─── Emulator (dev เท่านั้น) ─────────────────────────────────────
# ปกติ dev เปิด emulator อัตโนมัติ · ใส่ false ใน .env.local ถ้าอยากต่อ Firebase จริง
# VITE_USE_EMULATORS=false
